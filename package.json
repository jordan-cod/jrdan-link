{
	"name": "jrdan-link",
	"private": true,
	"type": "module",
	"workspaces": [
		"redirect",
		"server",
		"web"
	],
	"scripts": {
		"dev": "bun run --filter '@jrdan-link/server' dev & bun run --filter '@jrdan-link/web' dev",
		"build": "bun run --filter '@jrdan-link/web' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '@jrdan-link/server' test",
		"check": "biome check --write .",
		"ci": "biome ci ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"typescript": "5.9.3"
	}
}
