{
  // Arquivos gerados — não editar na mão
  "files.readonlyInclude": {
    "internal/db/**": true,
    "go.sum": true
  },
  "gopls": {
    "formatting.gofumpt": true
  },
  "go.lintTool": "golangci-lint",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "[sql]": {
    "editor.formatOnSave": false
  },
  "files.exclude": {
    "tmp": true
  },
  "search.exclude": {
    "internal/db": true,
    "go.sum": true
  }
}
