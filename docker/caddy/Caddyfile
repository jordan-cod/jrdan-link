{
	order rate_limit before reverse_proxy
}

http://app.localhost {
	rate_limit {
		zone create_link {
			match {
				method POST
				path /links
			}
			key {remote_host}
			events 10
			window 1m
		}
		zone redirect {
			match {
				method GET
				not path /healthz /docs /openapi.yaml
			}
			key {remote_host}
			events 100
			window 1s
		}
	}
	reverse_proxy tracker:8080
}

http://redis.localhost {
	reverse_proxy redisinsight:5540
}
